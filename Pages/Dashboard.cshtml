@page
@model Shortly.Pages.DashboardModel

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Dashboard</h2>

        <form method="post" asp-page-handler="Logout">
            <button class="btn btn-danger">
                Cerrar sesión
            </button>
        </form>
    </div>

    <div class="card p-4 mb-4">
        <h4 class="mb-3">Crear Link Corto</h4>

        <form method="post">
            <div class="mb-3">
                <input asp-for="Url" class="form-control" placeholder="https://google.com" />
            </div>

            <button class="btn btn-primary">
                Crear Link
            </button>
        </form>
    </div>

    <h4>Mis Links</h4>

    <table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>URL Original</th>
                <th>Short URL</th>
                <th>Clicks</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var link in Model.Links)
        {
            <tr>
                <td>@link.Url</td>
                <td>
                    <a href="/@link.ShortUrl" target="_blank">
                        @link.ShortUrl
                    </a>
                </td>
                <td>@link.Clicks</td>
            </tr>
        }
        </tbody>
    </table>
</div>